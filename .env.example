# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX

# Replace G-XXXXXXXXXX with your actual Google Analytics 4 measurement ID
# You can get this from your Google Analytics dashboard

# Other analytics (optional)
NEXT_UMAMI_ID=

# Site configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin / CMS-lite
# Postgres connection string from a free Neon project (https://neon.tech)
# Use the POOLED connection string (host contains "-pooler") for app runtime
# queries — this is what Prisma Client uses at request time.
# e.g. postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
# Use the DIRECT/UNPOOLED connection string (same host WITHOUT "-pooler")
# for migrations. `prisma migrate deploy` needs session-level Postgres
# advisory locks, which PgBouncer transaction pooling doesn't support —
# using the pooled URL here causes `Error: P1002 ... timed out trying to
# acquire a postgres advisory lock`.
# e.g. postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=
# bcrypt hash of the admin password, base64-encoded. The raw hash (full of
# literal `$` characters, e.g. "$2b$10$...") gets corrupted somewhere along
# the env-loading chain (Next.js dev/Turbopack env propagation); base64 has
# no characters special to any shell/dotenv/IPC layer, so it survives
# everywhere unmodified. lib/auth.ts decodes it back before comparing.
# Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH=

# Vercel Blob storage token (free tier). Generated automatically when you
# connect a Blob store to your Vercel project (Storage tab), or create one
# with `npx vercel blob store add` and copy it here for local dev.
BLOB_READ_WRITE_TOKEN=


