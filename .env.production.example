# Copy this to .env.production on the server and fill in real values.
# Never commit the real .env.production file.
#
# NOTE: production deploys now happen on Vercel (git push → auto build),
# where these are set as Project → Settings → Environment Variables instead
# of a file. This file is only needed if you ever go back to the
# self-hosted VPS + Docker path documented in DEPLOYMENT.md.

NODE_ENV=production

# Postgres connection string from a free Neon project (https://neon.tech).
# The database is shared infra now (not a local file), so the same
# DATABASE_URL format is used everywhere — Vercel, VPS, and local dev.
# Use the POOLED host (contains "-pooler") here — this is used by Prisma
# Client at runtime for normal queries.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct/unpooled connection string (same host WITHOUT "-pooler"). Required
# for `prisma migrate deploy` (runs in vercel-build): PgBouncer transaction
# pooling doesn't support the session-level advisory lock Prisma migrations
# take, which causes `Error: P1002 ... timed out trying to acquire a
# postgres advisory lock`.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# bcrypt hash of the admin password, base64-encoded (see .env.example for
# why). Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH=

# Vercel Blob storage token (free tier) — used for uploaded images instead
# of local disk.
BLOB_READ_WRITE_TOKEN=

# Site URL (used in metadata/SEO + sitemap/feed generation)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_UMAMI_ID=



